RODIUMAI_API_KEY=rd_sk_YOUR_KEY
RODIUMAI_MODEL=openai/gpt-4o-mini
RODIUMAI_ALLOWED_MODELS=openai/gpt-4o-mini,google/gemini-2.0-flash-001

# Recherche web (Tavily)
TAVILY_API_KEY=

# Météo (WeatherAPI)
WEATHERAPI_KEY=

# Google Calendar + Drive (OAuth refresh token)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Notion
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# Email (SMTP, ex. Gmail avec mot de passe d'application)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

